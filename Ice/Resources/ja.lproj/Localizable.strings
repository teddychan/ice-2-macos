/* Ice 2 — ja
   App-owned UI strings, resolved through DragonKit's L(_:).

   Keys are SEMANTIC (app.general.launchAtLogin), never the English text, so a copy edit is
   not a key rename across eight files.

   The `app.` prefix is load-bearing: DragonKit's L(_:) resolves its own bundle first, so a
   `DragonKit.` key here could never win (dragon-kit CONFORMANCE.md §R8). Shared wording comes
   from the kit with L("DragonKit.…").

   Every key must exist in all eight languages with matching format specifiers. */

"app.nav.general" = "一般";
"app.general.launchAtLogin" = "ログイン時に起動";
"app.updates.notification.title" = "新しいアップデートがあります";
"app.updates.notification.body" = "%@ が新しいバージョンを見つけました。";
"app.uninstall.item.app" = "App とそのログイン項目";
"app.uninstall.item.settings" = "設定、レイアウトプロファイル、ホットキー";
"app.uninstall.item.state" = "保存されたアプリケーションの状態";
"app.uninstall.item.caches" = "キャッシュとサポートファイル";
"app.settings.windowTitle" = "%@ 設定";
"app.general.startup" = "起動";
"app.whatsNew.summary" = "Ice 2 を macOS 27 向けに作り直しました。メニューバーの各項目は「表示」か「非表示」のどちらかで、非表示の項目は Ice アイコンの下の Ice Bar にまとまります。";
