"app.uninstall.item.settings" = "設定、版面描述檔和快速鍵";
"app.uninstall.item.state" = "已儲存的應用程式狀態";
"app.uninstall.item.caches" = "快取和支援檔案";
"app.settings.windowTitle" = "%@ 設定";
